{# The full wordmark. Pass `label` where the mark is the only name of the thing
   it stands for (the footer); leave it empty where visible text already says it. #}
{% macro mark(classes="", label="") %}
<svg class="{{ classes }}" viewBox="0 0 581.3 242" focusable="false"
     {%- if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}>
  <use href="#savva-wordmark"/>
</svg>
{%- endmacro %}

{# The "S" alone, for the branded stand-in tile. Always decorative: the tile
   around it carries the label. #}
{% macro monogram(classes="") %}
<svg class="{{ classes }}" viewBox="0 0 116.3 162.7" aria-hidden="true" focusable="false">
  <use href="#savva-monogram"/>
</svg>
{%- endmacro %}
