{# section: footer — six blocks: mark, navigation, Instagram, Google Maps,
   contacts, copyright. Instagram and Google Maps are two separate lines, not
   one "social" row. The Savva mark is inlined, not <img>: its single path uses
   fill="currentColor", which is what makes it cream on the espresso ground. #}
{% from "macros/brand.njk" import mark %}
{% from "macros/nav.njk" import navLinkItems, languageSwitch %}
{% from "macros/hours.njk" import hourRuns %}
{% set footerLink = "relative inline-flex min-h-11 items-center text-small text-latte transition-colors duration-200 ease-brand hover:text-cream after:absolute after:bottom-1 after:start-0 after:h-px after:w-0 after:bg-current after:transition-[width] after:duration-200 after:ease-brand hover:after:w-full" %}

<footer class="bg-espresso text-cream" data-reveal>
  <div class="container-page py-24 md:py-32">
    <div class="grid gap-x-10 gap-y-14 md:grid-cols-12">

      {# 1 — the mark #}
      <div class="md:col-span-3">
        {{ mark("h-12 w-auto text-cream md:h-14", t.footer.logoAlt) }}
        <p class="mt-6 max-w-[24ch] text-small text-latte">{{ t.footer.ratingNote }}</p>
      </div>

      {# 2 — navigation, the same six anchors as the header #}
      <nav class="md:col-span-3" aria-label="{{ t.a11y.footerNav }}">
        <h2 class="eyebrow text-latte">{{ t.footer.navTitle }}</h2>
        {# Three rows, column flow: reading down a column keeps the header's order. #}
        <ul class="mt-5 grid grid-rows-3 grid-flow-col gap-x-6 gap-y-1">
          {{ navLinkItems(t.nav.links, footerLink, false) }}
        </ul>
      </nav>

      {# 3 — Instagram, its own line #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.followTitle }}</h2>
        <p class="mt-5">
          <a class="{{ footerLink }}" href="{{ site.links.instagram }}" target="_blank" rel="noopener">{{ t.footer.instagram }}</a>
        </p>
      </div>

      {# 4 — Google Maps, its own line, the same canonical link as Visit Us #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.findTitle }}</h2>
        <p class="mt-5">
          <a class="{{ footerLink }}" href="{{ site.links.maps }}" target="_blank" rel="noopener">{{ t.footer.maps }}</a>
        </p>
      </div>

      {# 5 — contacts in one group #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.contactTitle }}</h2>
        <address class="mt-5 text-small not-italic text-latte">
          <span class="block text-cream">{{ site.address.fullAr if dir == "rtl" else site.address.full }}</span>
          <a class="{{ footerLink }} mt-2" href="{{ site.phone.href }}" dir="ltr">{{ site.phone.display }}</a>
          {{ hourRuns(site, t, "mt-2 block") }}
        </address>
      </div>
    </div>

    {# 6 — copyright, with the language switch repeated from the header #}
    <div class="mt-16 flex flex-wrap items-center justify-between gap-x-10 gap-y-4 border-t border-cream/15 pt-8">
      <p class="text-small text-latte">{{ t.footer.copyright | replace("{year}", build.year) }}</p>
      {{ languageSwitch(t, "flex items-center gap-3 text-small", "text-cream", "text-latte/40", footerLink, true) }}
    </div>
  </div>
</footer>
