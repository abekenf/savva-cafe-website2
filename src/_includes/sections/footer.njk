        <p class="mt-6 max-w-[24ch] text-small text-latte">{{ t.footer.ratingNote }}</p>
      </div>

      {# 2 — navigation, the same six anchors as the header #}
      <nav class="md:col-span-3" aria-label="{{ t.a11y.footerNav }}">
        <h2 class="eyebrow text-latte">{{ t.footer.navTitle }}</h2>
        {# Three rows, column flow: reading down a column keeps the header's order. #}
        <ul class="mt-5 grid grid-rows-3 grid-flow-col gap-x-6 gap-y-1">
          {% for link in t.nav.links %}
          <li><a class="{{ footerLink }}" href="{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      {# 3 — Instagram, its own line #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.followTitle }}</h2>
        <p class="mt-5">
          <a class="{{ footerLink }}" href="{{ site.links.instagram }}" target="_blank" rel="noopener">{{ t.footer.instagram }}</a>
        </p>
      </div>

      {# 4 — Google Maps, its own line, the same canonical link as Visit Us #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.findTitle }}</h2>
        <p class="mt-5">
          <a class="{{ footerLink }}" href="{{ site.links.maps }}" target="_blank" rel="noopener">{{ t.footer.maps }}</a>
        </p>
      </div>

      {# 5 — contacts in one group #}
      <div class="md:col-span-2">
        <h2 class="eyebrow text-latte">{{ t.footer.contactTitle }}</h2>
        <address class="mt-5 text-small not-italic text-latte">
          <span class="block text-cream">{{ site.address.full }}</span>
          <a class="{{ footerLink }} mt-2" href="{{ site.phone.href }}" dir="ltr">{{ site.phone.display }}</a>
          {# The condensed lines are derived from the same seven rows Visit Us prints, by
             folding runs of days that share opens/closes. No second source of truth: split
             any weekday in site.json and this grows a line instead of lying. #}
          {% set hourRuns = [] %}
          {% for row in site.hours %}
            {% set previous = hourRuns[hourRuns.length - 1] if hourRuns.length else null %}
            {% if previous and previous.opens == row.opens and previous.closes == row.closes %}
              {% set ignored = previous.days.push(row.day) %}
            {% else %}
              {% set ignored = hourRuns.push({ opens: row.opens, closes: row.closes, days: [row.day] }) %}
            {% endif %}
          {% endfor %}
          {% for run in hourRuns %}
          <span class="mt-2 block">
            {%- if run.days.length > 1 -%}
              {{ t.visit.days[run.days[0]] }}&ndash;{{ t.visit.days[run.days[run.days.length - 1]] }}
            {%- else -%}
              {{ t.visit.days[run.days[0]] }}
            {%- endif %}
            <span dir="ltr" class="whitespace-nowrap tabular-nums">{{ run.opens }}&ndash;{{ run.closes }}</span>
          </span>
          {% endfor %}
        </address>
      </div>
    </div>

    {# 6 — copyright, with the language switch repeated from the header #}
    <div class="mt-16 flex flex-wrap items-center justify-between gap-x-10 gap-y-4 border-t border-cream/15 pt-8">
      <p class="text-small text-latte">{{ t.footer.copyright | replace("{year}", build.year) }}</p>
      <p class="flex items-center gap-3 text-small">
        <span class="text-cream" aria-current="true">{{ t.nav.language.current }}</span>
        <span class="text-latte/40" aria-hidden="true">/</span>
        <a class="{{ footerLink }}" href="{{ t.nav.language.otherHref }}"
           hreflang="{{ t.nav.language.otherLang }}" lang="{{ t.nav.language.otherLang }}"
           aria-label="{{ t.a11y.languageSwitch }}">{{ t.nav.language.other }}</a>
      </p>
    </div>
  </div>
</footer>
