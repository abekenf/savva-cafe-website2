{# section: footer — six blocks: mark, navigation, Instagram, Google Maps,
   contacts, copyright. Instagram and Google Maps are two separate lines, not
   one "social" row. The Savva mark is inlined, not <img>: its single path uses
   fill="currentColor", which is what makes it cream on the espresso ground. #}
{% set footerLink = "relative inline-flex min-h-8 items-center text-small text-latte transition-colors duration-200 ease-brand hover:text-cream after:absolute after:bottom-1 after:start-0 after:h-px after:w-0 after:bg-current after:transition-[width] after:duration-200 after:ease-brand hover:after:w-full" %}

<footer class="bg-espresso text-cream" data-reveal>
  <div class="container-page py-24 md:py-32">
    <div class="grid gap-x-10 gap-y-14 md:grid-cols-12">

      {# 1 — the mark #}
      <div class="md:col-span-3">
