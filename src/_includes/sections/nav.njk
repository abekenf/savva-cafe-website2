{# section: nav — light bar. Mark, four anchors, language pair, and the one act
   the bar carries. Markup and styling only: the scrolled state, the panel and
   the active link are set by app.js through the data-attributes declared here.
   Below 768px the anchors move to the bottom tab bar, so the bar keeps only
   the mark, the language pair and the burger for the rest. #}
{% from "macros/brand.njk" import mark %}
{% from "macros/nav.njk" import navLinkItems, languageSwitch %}

<nav id="nav" class="nav" data-nav aria-label="{{ t.a11y.primaryNav }}">
  <div class="container-page nav__bar">
    <a class="nav__brand" href="#hero" aria-label="{{ t.nav.brandAlt }}">
      {{ mark("nav__mark") }}
    </a>

    <ul class="nav__links">
      {{ navLinkItems(t.nav.links, "nav__link") }}
    </ul>

    <div class="nav__end">
      {{ languageSwitch(t, "nav__lang", "nav__lang-current", "nav__lang-sep", "nav__lang-other") }}

      <a class="btn btn--primary nav__cta" href="{{ site.links.maps }}" target="_blank" rel="noopener">{{ t.hero.ctaDirections }}</a>

      <button class="nav__toggle" type="button" data-nav-toggle aria-expanded="false"
              aria-controls="nav-panel" aria-label="{{ t.a11y.openMenu }}"
              data-label-open="{{ t.a11y.openMenu }}" data-label-close="{{ t.a11y.closeMenu }}">
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  {# Closed until app.js opens it; `hidden` keeps it out of the tab order. #}
  <div class="nav__panel" id="nav-panel" hidden>
    <ul class="nav__panel-list">
      {{ navLinkItems(t.nav.links, "nav__panel-link") }}
    </ul>
    {{ languageSwitch(t, "nav__panel-lang", "nav__lang-current", "nav__lang-sep", "nav__lang-other") }}
  </div>
</nav>
