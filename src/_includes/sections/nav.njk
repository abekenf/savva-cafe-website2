,220.3 429,220.3 430,221 429.3,224.7 419.7,224.7 418.7,226.3 419.3,229 429,229.7 428.3,233 419.7,233 418.7,235.7 419.3,237.3 430,237.7 430.7,240.3 429.7,241.7 414.3,241.3 414,221.3 415.3,220.3Z M214.3,224.7 210.3,227 209,232.3 211.3,236.3 216.3,237.7 220.3,235.3 221.3,233.3 221.3,229 218,225 214.3,224.7Z"/>
      </svg>
    </a>

    <ul class="nav__links">
      {% for link in t.nav.links %}
      <li><a class="nav__link" href="{{ link.href }}" data-nav-link="{{ link.id }}" aria-current="false">{{ link.label }}</a></li>
      {% endfor %}
    </ul>

    <div class="nav__end">
      <p class="nav__lang">
        <span class="nav__lang-current">{{ t.nav.language.current }}</span>
        <span class="nav__lang-sep" aria-hidden="true">/</span>
        <a class="nav__lang-other" href="{{ t.nav.language.otherHref }}"
           lang="{{ t.nav.language.otherLang }}" hreflang="{{ t.nav.language.otherLang }}"
           aria-label="{{ t.a11y.languageSwitch }}">{{ t.nav.language.other }}</a>
      </p>

      <button class="nav__toggle" type="button" data-nav-toggle aria-expanded="false"
              aria-controls="nav-panel" aria-label="{{ t.a11y.openMenu }}"
              data-label-open="{{ t.a11y.openMenu }}" data-label-close="{{ t.a11y.closeMenu }}">
        <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  {# Closed until ticket 06 opens it; `hidden` keeps it out of the tab order. #}
  <div class="nav__panel" id="nav-panel" hidden>
    <ul class="nav__panel-list">
      {% for link in t.nav.links %}
      <li><a class="nav__panel-link" href="{{ link.href }}" data-nav-link="{{ link.id }}" aria-current="false">{{ link.label }}</a></li>
      {% endfor %}
    </ul>
    <p class="nav__panel-lang">
      <span class="nav__lang-current">{{ t.nav.language.current }}</span>
      <span class="nav__lang-sep" aria-hidden="true">/</span>
      <a class="nav__lang-other" href="{{ t.nav.language.otherHref }}"
         lang="{{ t.nav.language.otherLang }}" hreflang="{{ t.nav.language.otherLang }}"
         aria-label="{{ t.a11y.languageSwitch }}">{{ t.nav.language.other }}</a>
    </p>
  </div>
</nav>
