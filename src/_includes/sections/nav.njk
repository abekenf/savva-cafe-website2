{# section: nav — sticky page chrome: brand mark, six anchors, language switch,
   burger below 768px. Markup and styling only; the scroll state, the panel and
   the active link are set by ticket 06 through the data-attributes declared here. #}

<style>
  /* ---- Draft badge -------------------------------------------------------
     Page-wide, declared once here because nav is present on every page and
     renders before every section. Any section may use `.draft-badge` beside a
     string that came back with its `<key>Draft` flag set; the badge disappears
     on its own when the owner clears the flag in the dictionary.
     Solid tint on purpose: it has to stay legible on paper and over a photo. */
  .draft-badge {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
    margin-inline-start: calc(var(--spacing) * 2);
    padding-inline: calc(var(--spacing) * 2);
    padding-block: 2px;
    border-radius: 9999px;
    background-color: #f5e8cd;
    color: #8a5a12;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: help;
  }

  [dir="rtl"] .draft-badge {
    text-transform: none;
    letter-spacing: 0;
  }

  /* ---- Navigation -------------------------------------------------------- */
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    color: var(--color-paper);
    transition: background-color 240ms var(--ease-brand), color 240ms var(--ease-brand),
      box-shadow 240ms var(--ease-brand);
  }

  /* Contrast scrim under the bar while it floats over the hero photograph. */
  .nav::before {
    content: "";
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    height: 140px;
    pointer-events: none;
    background: linear-gradient(to bottom, rgb(43 36 27 / 0.45), rgb(43 36 27 / 0));
    opacity: 1;
    transition: opacity 240ms var(--ease-brand);
  }

  /* One of the two places in the project allowed to use blur (spec § story 17). */
  .nav[data-nav-scrolled],
  .nav[data-nav-open] {
    background-color: rgb(250 247 240 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--color-ink);
    box-shadow: 0 1px 0 rgb(43 36 27 / 0.08);
  }

  .nav[data-nav-scrolled]::before,
  .nav[data-nav-open]::before {
    opacity: 0;
  }

  /* No JavaScript: nothing will ever set `data-nav-scrolled`, so the bar stays
     solid from the first pixel rather than staying invisible over pale sections. */
  @media (scripting: none) {
    .nav {
      background-color: rgb(250 247 240 / 0.92);
      color: var(--color-ink);
      box-shadow: 0 1px 0 rgb(43 36 27 / 0.08);
    }

    .nav::before {
      opacity: 0;
    }
  }

  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--spacing) * 6);
    min-height: 64px;
  }

  @media (min-width: 768px) {
    .nav__bar {
      min-height: 80px;
    }
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    flex: none;
  }

  .nav__mark {
    display: block;
    width: auto;
    height: 20px;
  }

  @media (min-width: 768px) {
    .nav__mark {
      height: 24px;
    }
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: clamp(18px, 2.2vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: calc(var(--spacing) * 2);
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 200ms var(--ease-brand);
  }

  /* Underline opens from the start edge — width, not transform, so RTL mirrors
     without a second rule. */
  .nav__link::after {
    content: "";
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 200ms var(--ease-brand);
  }

  .nav__link[aria-current="true"] {
    opacity: 1;
  }

  .nav__link[aria-current="true"]::after {
    width: 100%;
  }

  @media (hover: hover) {
    .nav__link:hover {
      opacity: 1;
    }

    .nav__link:hover::after {
      width: 100%;
    }
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    flex: none;
  }

  .nav__lang {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .nav__lang-current {
    color: inherit;
  }

  .nav__lang-sep {
    opacity: 0.4;
  }

  .nav__lang-other {
    color: inherit;
    opacity: 0.6;
    text-decoration: none;
    transition: opacity 200ms var(--ease-brand);
  }

  @media (hover: hover) {
    .nav__lang-other:hover {
      opacity: 1;
    }
  }

  .nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-inline-end: -12px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .nav__toggle {
      display: none;
    }
  }

  .nav__burger {
    display: block;
    position: relative;
    width: 22px;
    height: 10px;
  }

  .nav__burger span {
    position: absolute;
    inset-inline: 0;
    height: 1.5px;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform 240ms var(--ease-brand), opacity 160ms var(--ease-brand);
  }

  .nav__burger span:first-child {
    inset-block-start: 0;
  }

  .nav__burger span:last-child {
    inset-block-end: 0;
  }

  .nav[data-nav-open] .nav__burger span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .nav[data-nav-open] .nav__burger span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* ---- Mobile panel ------------------------------------------------------ */
  .nav__panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    background-color: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 768px) {
    .nav__panel {
      display: none;
    }
  }

  .nav__panel-list {
    margin: 0;
    padding-block: calc(var(--spacing) * 2);
    padding-inline: var(--spacing-gutter);
    list-style: none;
  }

  .nav__panel-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    border-block-end: 1px solid rgb(43 36 27 / 0.07);
  }

  .nav__panel-link[aria-current="true"] {
    color: var(--color-sage-deep);
  }

  .nav__panel-list li:last-child .nav__panel-link {
    border-block-end: 0;
  }

  .nav__panel-lang {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    min-height: 52px;
    padding-inline: var(--spacing-gutter);
    padding-block-end: calc(var(--spacing) * 2);
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }

  .nav__panel-lang .nav__lang-current {
    color: var(--color-ink);
  }

  .nav__panel-lang .nav__lang-other {
    color: var(--color-ink-soft);
    opacity: 1;
  }
</style>

<nav id="nav" class="nav" data-nav aria-label="{{ t.a11y.primaryNav }}">
  <div class="container-page nav__bar">
    <a class="nav__brand" href="#hero" aria-label="{{ t.nav.brandAlt }}">
      {# Inlined, not <img>: the mark is recoloured through currentColor, and
         src/assets/images/ is not copied to the output. #}
      <svg class="nav__mark" viewBox="0 0 581.3 242" xmlns="http://www.w3.org/2000/svg"
           aria-hidden="true" focusable="false">
