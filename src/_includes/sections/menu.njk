{# section: menu — six signature items, order fixed by the dictionary.
   An item whose `image` is an empty string, or whose file is not on disk yet,
   gets the branded sage tile instead of someone else's photograph. #}

<style>
  .menu {
    background-color: var(--color-sand);
    /* Anchor jumps land below the fixed bar, not under it. */
    scroll-margin-block-start: 64px;
  }

  @media (min-width: 768px) {
    .menu {
      scroll-margin-block-start: 80px;
    }
  }

  .menu__head {
    max-width: var(--spacing-measure);
    margin-block-end: clamp(40px, 6vw, 72px);
  }

  .menu__eyebrow {
    margin-block-end: calc(var(--spacing) * 5);
  }

  .menu__title {
    margin: 0;
    font-size: var(--text-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 700;
    text-wrap: balance;
  }

  .menu__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--spacing) * 6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .menu__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .menu__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: calc(var(--spacing) * 8);
    }
  }

  .menu__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-sage);
  }

  .menu__frame picture,
  .menu__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Branded stand-in (spec § story 25): the Savva "S" on sage, and a caption
     that says plainly that the photograph is missing. */
  .menu__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--spacing) * 5);
    width: 100%;
    height: 100%;
    background-color: var(--color-sage);
    color: var(--color-cream);
  }

  .menu__monogram {
    width: auto;
    height: clamp(48px, 11vw, 72px);
    opacity: 0.9;
  }

  .menu__tile-note {
    margin: 0;
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(222 207 184 / 0.85);
  }

  [dir="rtl"] .menu__tile-note {
    letter-spacing: 0;
    text-transform: none;
  }

  .menu__body {
    padding: calc(var(--spacing) * 6) calc(var(--spacing) * 6) calc(var(--spacing) * 7);
  }

  .menu__name {
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .menu__desc {
    margin-block: calc(var(--spacing) * 2) 0;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>

<section id="menu" class="section menu" aria-labelledby="menu-title">
  <div class="container-page">
    <div class="menu__head">
      <p class="eyebrow menu__eyebrow" data-reveal>{{ t.menu.eyebrow }}</p>
      <h2 id="menu-title" class="menu__title" data-reveal data-reveal-delay="60">{{ t.menu.title }}</h2>
    </div>

    <ul class="menu__grid">
      {% for item in t.menu.items %}
      <li>
        <article class="card menu__card" data-menu-item="{{ item.id }}" data-reveal data-reveal-delay="{{ loop.index0 * 60 }}">
          <div class="menu__frame">
            {% if item.image and item.image in media.files %}
              {% image item.image, item.imageAlt, "(min-width: 1440px) 420px, (min-width: 1024px) 29vw, (min-width: 640px) 44vw, 90vw" %}
            {% else %}
              <div class="menu__tile" role="img" aria-label="{{ item.imageAlt }}">
                <svg class="menu__monogram" viewBox="0 0 116.3 162.7" xmlns="http://www.w3.org/2000/svg"
                     aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M59,0 74.7,1 89.3,5.7 101,12.7 110.3,22.3 115,32.3 115.3,43.3 111,54 102,64 100,65.3 99,65 90.3,53.7 77.3,42.7 64.7,35.7 51.3,31 37.7,28.7 23,29.3 18.7,30.7 14.3,33.7 13.7,35 14.3,39.3 20,44.7 29.7,49.7 45.7,55.3 74,63.3 83.7,67.3 96.7,74.7 106,82.7 111,89.3 115.7,101 116.3,112.3 114,124.3 110,133.3 105.3,140.3 96.3,149.3 88.3,154.7 75.7,160 64,162.3 50.7,162.7 39.3,161 26.3,156.7 16.7,150.7 8.7,142 3.3,130 2.7,118 5,109.7 9,103.3 16.7,96.7 26,93 36.3,92.7 45.7,95.3 46.7,97.7 43.7,104.7 42,114 42.3,123.7 44,131.3 47,138.3 51.7,145 57.3,149.7 63.7,152.3 68.3,152.7 76,150.7 82,146.7 85.7,142.7 88.7,137.7 90.7,130.7 90.7,124.3 88.7,117.3 84.7,111 79.7,106 73,101.3 56.7,93.3 29,82 13.7,73 5.7,64.7 2,58 0.3,52 0,44.3 2,35.3 5.7,28 11,21 18.7,14 27,8.7 36.7,4.3 47.3,1.3 59,0Z"/>
                </svg>
                <p class="menu__tile-note">{{ t.menu.photoComingSoon }}</p>
              </div>
            {% endif %}
          </div>

          <div class="menu__body">
            <h3 class="menu__name">{{ item.name }}</h3>
            <p class="menu__desc">{{ item.desc }}{% if item.descDraft %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>
          </div>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
