{# section: menu — the centre of the page. Six signature items as cards, each a
   photograph, a name and one line. No prices: the owner asked for a showcase,
   not a price list. An item without a frame gets the branded tile. #}
{% from "macros/brand.njk" import monogram %}

<section id="menu" class="section menu" aria-labelledby="menu-title">
  <div class="container-page">
    <header class="section-head">
      <h2 id="menu-title" class="section-title">{{ t.menu.title }}</h2>
      <p class="section-lead">{{ t.menu.lead }}{% if t.menu.leadDraft and build.preview %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>
    </header>

    <ul class="menu__grid">
      {% for item in t.menu.items %}
      <li class="card menu__card" data-menu-item="{{ item.id }}" data-reveal data-reveal-delay="{{ loop.index0 * 60 }}">
        <div class="menu__frame">
          {% if item.image in media.files %}
            {% image item.image, item.imageAlt, "(min-width: 1024px) 30vw, (min-width: 640px) 44vw, 88vw", false, "menu__photo" %}
          {% else %}
            <div class="menu__tile">
              {{ monogram("menu__monogram") }}
              <p class="menu__tile-note">{{ t.menu.photoComingSoon }}</p>
            </div>
          {% endif %}
        </div>
        <div class="menu__body">
          <h3 class="menu__name">{{ item.name }}</h3>
          <p class="menu__desc">{{ item.desc }}{% if item.descDraft and build.preview %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
