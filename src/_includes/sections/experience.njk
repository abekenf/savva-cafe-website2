{# section: experience — six things to expect, in the order fixed by the spec.
   Icons are drawn here: inline SVG, 32px, stroke 1.25, sage, no fill.
   All six share one optical density — same box, same stroke, same 20px content. #}

{% macro experienceIcon(id) %}
<svg class="h-8 w-8 shrink-0 text-sage" viewBox="0 0 32 32" fill="none" stroke="currentColor"
     stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if id == "specialty-coffee" -%}
  <g transform="rotate(-35 16 16)">
    <ellipse cx="16" cy="16" rx="7" ry="11"/>
    <path d="M16 5.2c-2.6 3.4-2.6 7.4 0 10.8s2.6 7.4 0 10.8"/>
  </g>
  {%- elif id == "fresh-desserts" -%}
  <path d="M16 6.5 26.5 25.5H5.5z"/>
  <path d="M10.4 18.5h11.2"/>
  {%- elif id == "cozy-interior" -%}
  <path d="M7 26.5V15a9 9 0 0 1 18 0v11.5"/>
  <path d="M4.5 26.5h23"/>
  {%- elif id == "free-wifi" -%}
  <path d="M4.5 12.5a16.5 16.5 0 0 1 23 0"/>
  <path d="M9 17.6a10 10 0 0 1 14 0"/>
  <path d="M13.4 22.6a4 4 0 0 1 5.2 0"/>
  <circle cx="16" cy="26.4" r="1"/>
  {%- elif id == "outdoor-seating" -%}
  <path d="M16 6.8c-6.2 0-11.5 4.6-11.5 8.4h23c0-3.8-5.3-8.4-11.5-8.4Z"/>
  <path d="M16 15.2v8.3a2.8 2.8 0 0 1-5.6 0"/>
  <path d="M16 4.6v2.2"/>
  {%- elif id == "friendly-staff" -%}
  <path d="M6.5 13.8h15v5.7a6 6 0 0 1-6 6h-3a6 6 0 0 1-6-6z"/>
  <path d="M21.5 15.8h1.8a3 3 0 0 1 0 6h-1.8"/>
  <path d="M11.6 5.6c-1.2 1.6-1.2 2.9 0 4.5M16.4 5.6c-1.2 1.6-1.2 2.9 0 4.5"/>
  {%- endif -%}
</svg>
{% endmacro %}

{% from "macros/ornament.njk" import sectionHead %}

<section id="experience" class="section bg-sand" aria-labelledby="experience-title" data-reveal>
  <div class="container-page">
    {{ sectionHead("experience-title", t.experience.title) }}

    <ul class="mt-14 grid grid-cols-2 gap-x-8 gap-y-12 md:mt-20 md:grid-cols-3 md:gap-x-12 md:gap-y-16">
      {% for item in t.experience.items %}
      <li class="flex flex-col items-center gap-4 text-center" data-reveal data-reveal-delay="{{ loop.index0 * 60 }}">
        {{ experienceIcon(item.id) }}
        <span class="text-h3 text-ink">{{ item.label }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
