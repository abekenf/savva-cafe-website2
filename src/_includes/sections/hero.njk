{# section: hero — light. Text on the left, one photograph in a rounded card on
   the right; no full-bleed image and no veil. The headline is the brand's own
   line from its Instagram bio (see hero.titleNote), so the largest type on the
   page is Savva's own words. #}
{% from "macros/hours.njk" import hourRuns %}

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="container-page hero__grid">
    <div class="hero__text">
      <p class="rating">
        <span aria-hidden="true">★ {{ site.rating.value }}</span>
        <span aria-hidden="true" class="rating__count">{{ site.rating.count }}</span>
        <span class="sr-only">{{ t.hero.ratingLabel | replace('{value}', site.rating.value) | replace('{count}', site.rating.count) }}</span>
      </p>

      {# English page: the brand's own line, verbatim. Arabic page: a proposed
         wording of it, flagged draft until the owner approves — an English
         headline on an Arabic page serves no one. #}
      <h1 id="hero-title" class="hero__title"{% if dir != "rtl" %} lang="en" dir="ltr"{% endif %}>{{ t.hero.title }}{% if t.hero.titleDraft and build.preview %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</h1>

      <p class="hero__subtitle">{{ t.hero.subtitle }}{% if t.hero.subtitleDraft and build.preview %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#menu">{{ t.hero.ctaMenu }}</a>
        <a class="btn btn--quiet" href="{{ site.links.maps }}" target="_blank" rel="noopener">{{ t.hero.ctaDirections }}</a>
      </div>

      <ul class="hero__facts" aria-label="{{ t.hero.infoLabel }}">
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21Z"/><circle cx="12" cy="10" r="2.3"/></svg>
          <span>{{ site.address.streetAddressAr if dir == "rtl" else site.address.streetAddress }}</span>
        </li>
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
          {# Folded from the same seven rows Visit prints in full — never retyped. #}
          <span class="hero__hours">{{ hourRuns(site, t, "", " · ") }}</span>
        </li>
      </ul>
    </div>

    <figure class="hero__figure">
      {% image t.hero.image, t.hero.imageAlt, "(min-width: 1024px) 46vw, 92vw", true %}
    </figure>
  </div>
</section>
