{# section: hero — full-screen photograph, one headline, two actions.
   The parallax layer only declares `data-parallax`; ticket 06 moves it. #}

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background-color: var(--color-espresso);
    color: var(--color-paper);
  }

  /* Taller than the frame so a 12% parallax shift never uncovers an edge. */
  .hero__media {
    position: absolute;
    inset-block-start: -8%;
    inset-inline: 0;
    height: 116%;
    z-index: -2;
    will-change: transform;
  }

  .hero__media picture,
  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Warm scrim: the text sits on it, not on the photograph. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(43 36 27 / 0.82) 0%, rgb(43 36 27 / 0.45) 38%, rgb(43 36 27 / 0.1) 70%, rgb(43 36 27 / 0.2) 100%);
  }

  .hero__body {
    padding-block-start: calc(var(--spacing) * 28);
    padding-block-end: clamp(72px, 14vh, 140px);
  }

  .hero__inner {
    max-width: 52ch;
  }

  .hero__eyebrow {
    color: var(--color-cream);
    margin-block-end: calc(var(--spacing) * 5);
  }

  .hero__title {
    max-width: 13ch;
    margin: 0;
    color: var(--color-paper);
    text-shadow: 0 1px 24px rgb(43 36 27 / 0.28);
  }

  .hero__subtitle {
    max-width: 46ch;
    margin-block: calc(var(--spacing) * 6) 0;
    color: rgb(250 247 240 / 0.88);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 3);
    margin-block-start: calc(var(--spacing) * 9);
  }

  /* The shared ghost button is drawn for paper backgrounds; on a photograph it
     needs its own pair of colours. */
  .hero__cta-secondary {
    color: var(--color-paper);
    border-color: rgb(250 247 240 / 0.45);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (hover: hover) {
    .hero__cta-secondary:hover {
      background-color: rgb(250 247 240 / 0.14);
      border-color: var(--color-paper);
    }
  }

  .hero__scroll {
    position: absolute;
    inset-block-end: clamp(20px, 4vh, 40px);
    inset-inline-end: var(--spacing-gutter);
    margin: 0;
    display: none;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    color: rgb(250 247 240 / 0.7);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  [dir="rtl"] .hero__scroll {
    letter-spacing: 0;
    text-transform: none;
  }

  .hero__scroll::after {
    content: "";
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, rgb(250 247 240 / 0.7), rgb(250 247 240 / 0));
  }

  @media (min-width: 1024px) {
    .hero__scroll {
      display: flex;
      flex-direction: column;
    }
  }
</style>

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__media" data-parallax>
    {% image t.hero.image, t.hero.imageAlt, "100vw", true %}
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="container-page hero__body">
    <div class="hero__inner">
      <p class="eyebrow hero__eyebrow" data-reveal>{{ t.hero.eyebrow }}</p>
      <h1 id="hero-title" class="h-display hero__title" data-reveal data-reveal-delay="60">{{ t.hero.title }}</h1>
      <p class="hero__subtitle" data-reveal data-reveal-delay="120">{{ t.hero.subtitle }}{% if t.hero.subtitleDraft %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>
      <div class="hero__actions" data-reveal data-reveal-delay="180">
        <a class="btn-primary" href="#menu">{{ t.hero.ctaMenu }}</a>
        <a class="btn-ghost hero__cta-secondary" href="{{ site.links.maps }}" target="_blank" rel="noopener">{{ t.hero.ctaDirections }}</a>
      </div>
    </div>
  </div>

  <p class="hero__scroll" aria-hidden="true">{{ t.hero.scrollHint }}</p>
</section>
