{# section: about — one short story beside one photograph. The brand's own line
   used to repeat here as a pull-quote; it now lives once, in the hero.
   Styling lives in src/css/main.css so it ships in the cached stylesheet instead
   of once per page. #}

{% from "macros/ornament.njk" import sectionHead %}

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="container-page about__grid">
    <div class="about__text">
      {{ sectionHead("about-title", t.about.title, true) }}
      <p class="about__body" data-reveal data-reveal-delay="120">{{ t.about.body }}{% if t.about.bodyDraft and build.preview %} <span class="draft-badge" title="{{ t.a11y.draftBadgeHint }}">{{ t.a11y.draftBadge }}</span>{% endif %}</p>
    </div>

    {% if t.about.image in media.files %}
    <figure class="about__figure" data-reveal data-reveal-delay="120">
      {% image t.about.image, t.about.imageAlt, "(min-width: 1440px) 500px, (min-width: 900px) 38vw, 90vw" %}
    </figure>
    {% endif %}
  </div>
</section>
