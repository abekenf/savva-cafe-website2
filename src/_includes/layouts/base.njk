<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {#- Public addresses are /and /ar: vercel.json sets cleanUrls, so the file
        names never appear in a link a search engine follows. -#}
    {% set base = site.url if not site.url.endsWith("/") else site.url.slice(0, -1) %}
    {% set selfUrl = base + ("/" if t.meta.path == "/" else t.meta.path) %}
    {% set otherUrl = base + ("/" if t.meta.altPath == "/" else t.meta.altPath) %}
    {% set ogImage = base + "/assets/static/og/savva-" + lang + ".jpg" %}

    <title>{{ t.meta.title }}</title>
    <meta name="description" content="{{ t.meta.description }}">
    <meta name="theme-color" content="#f7f1e9">
    <link rel="canonical" href="{{ selfUrl }}">

    <link rel="alternate" hreflang="en" href="{{ base }}/">
    <link rel="alternate" hreflang="ar" href="{{ base }}/ar">
    <link rel="alternate" hreflang="x-default" href="{{ base }}/">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.legalName }}">
    <meta property="og:title" content="{{ t.meta.title }}">
    <meta property="og:description" content="{{ t.meta.description }}">
    <meta property="og:url" content="{{ selfUrl }}">
    <meta property="og:locale" content="{{ site.locale[lang] }}">
    <meta property="og:locale:alternate" content="{{ site.locale[t.nav.language.otherLang] }}">
    <meta property="og:image" content="{{ ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ t.meta.ogAlt }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ t.meta.title }}">
    <meta name="twitter:description" content="{{ t.meta.description }}">
    <meta name="twitter:image" content="{{ ogImage }}">
    <meta name="twitter:image:alt" content="{{ t.meta.ogAlt }}">

    <link rel="icon" href="/assets/static/icons/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/assets/static/icons/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/assets/static/icons/apple-touch-icon.png">
    <link rel="manifest" href="/assets/static/icons/site.webmanifest">

    {#- Every value below comes from src/_data/site.json. Nothing here is typed
        by hand: a second copy of the address or the hours would drift. -#}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": ["Restaurant", "CafeOrCoffeeShop"],
        "name": {{ (site.nameAr if lang == "ar" else site.legalName) | dump | safe }},
        "url": {{ selfUrl | dump | safe }},
        "image": [{{ ogImage | dump | safe }}],
        "telephone": {{ site.phone.display | dump | safe }},
        "priceRange": "$$",
        "servesCuisine": ["Coffee", "Desserts"],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ site.address.streetAddress | dump | safe }},
          "addressLocality": {{ site.address.addressLocality | dump | safe }},
          "addressRegion": {{ site.address.addressRegion | dump | safe }},
          "postalCode": {{ site.address.postalCode | dump | safe }},
          "addressCountry": {{ site.address.addressCountry | dump | safe }}
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ site.geo.latitude }},
          "longitude": {{ site.geo.longitude }}
        },
        "openingHoursSpecification": [
          {%- for hour in site.hours %}
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": {{ hour.dayOfWeek | dump | safe }},
            "opens": {{ hour.opens | dump | safe }},
            "closes": {{ hour.closes | dump | safe }}
          }{{ "," if not loop.last }}
          {%- endfor %}
        ],
        "sameAs": [
          {{ site.links.instagram | dump | safe }},
          {{ site.links.maps | dump | safe }}
        ]
      }
    </script>

    {#- One preload per page: the weight the first screen actually paints with
        — 700 for the Latin display face, 600 for the Arabic one. The path comes
        from `build.preloadFont` in .eleventy.js so that it is declared once;
        test/build.test.js checks that main.css declares the same file. -#}
    <link rel="preload" as="font" type="font/woff2"
          href="{{ build.preloadFont[dir] }}" crossorigin>

    <link rel="stylesheet" href="/assets/app.css">
    <script src="/js/app.js" defer></script>
  </head>
  <body>
    {% from "macros/brand.njk" import sprite %}
    {{ sprite() }}
    <a class="skip-link" href="#main">{{ t.a11y.skipToContent }}</a>

    {{ content | safe }}
  </body>
</html>
